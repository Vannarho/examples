<TodaysMarket>
  <Configuration id="default">
    <DiscountingCurvesId>default</DiscountingCurvesId>
    <YieldCurvesId>default</YieldCurvesId>
    <IndexForwardingCurvesId>default</IndexForwardingCurvesId>
    <SwapIndexCurvesId>default</SwapIndexCurvesId>
    <FxSpotsId>default</FxSpotsId>
    <FxVolatilitiesId>default</FxVolatilitiesId>
    <SwaptionVolatilitiesId>default</SwaptionVolatilitiesId>
    <CapFloorVolatilitiesId>default</CapFloorVolatilitiesId>
    <EquityCurvesId>default</EquityCurvesId>
    <EquityVolatilitiesId>default</EquityVolatilitiesId>
    <CommodityCurvesId>default</CommodityCurvesId>
    <CommodityVolatilitiesId>default</CommodityVolatilitiesId>
  </Configuration>
  <Configuration id="xois_eur">
    <DiscountingCurvesId>default</DiscountingCurvesId>
    <YieldCurvesId>default</YieldCurvesId>
    <IndexForwardingCurvesId>default</IndexForwardingCurvesId>
    <SwapIndexCurvesId>default</SwapIndexCurvesId>
    <FxSpotsId>default</FxSpotsId>
    <FxVolatilitiesId>default</FxVolatilitiesId>
    <SwaptionVolatilitiesId>default</SwaptionVolatilitiesId>
    <CapFloorVolatilitiesId>default</CapFloorVolatilitiesId>
    <EquityCurvesId>default</EquityCurvesId>
    <EquityVolatilitiesId>default</EquityVolatilitiesId>
    <CommodityCurvesId>default</CommodityCurvesId>
    <CommodityVolatilitiesId>default</CommodityVolatilitiesId>
  </Configuration>

  <!-- FX spots/vols (EURUSD only for this pared-down FD set) -->
  <FxVolatilities id="default">
    <FxVolatility pair="EURUSD">FXVolatility/EUR/USD/EURUSD</FxVolatility>
  </FxVolatilities>

  <FxVolatilities id="xois_eur">
    <FxVolatility pair="EURUSD">FXVolatility/EUR/USD/EURUSD</FxVolatility>
  </FxVolatilities>

  <!-- Minimal yield/discounting sets needed for EQ curves in this example -->
  <YieldCurves id="default">
    <YieldCurve name="EUR1D">Yield/EUR/EUR1D</YieldCurve>
    <YieldCurve name="EUR3M">Yield/EUR/EUR3M</YieldCurve>
    <YieldCurve name="EUR6M">Yield/EUR/EUR6M</YieldCurve>
    <YieldCurve name="BOND_YIELD_EUR">Yield/EUR/BOND_YIELD_EUR</YieldCurve>
    <YieldCurve name="USD1D">Yield/USD/USD1D</YieldCurve>
    <YieldCurve name="USD3M">Yield/USD/USD3M</YieldCurve>
    <YieldCurve name="USD6M">Yield/USD/USD6M</YieldCurve>
  </YieldCurves>

  <DiscountingCurves id="default">
    <DiscountingCurve currency="EUR">Yield/EUR/EUR1D</DiscountingCurve>
    <DiscountingCurve currency="USD">Yield/USD/USD1D</DiscountingCurve>
  </DiscountingCurves>

  <!-- Index forwarding curves used by swaps and model calibration -->
  <IndexForwardingCurves id="default">
    <Index name="EUR-EURIBOR-3M">Yield/EUR/EUR3M</Index>
    <Index name="EUR-EURIBOR-6M">Yield/EUR/EUR6M</Index>
    <Index name="EUR-ESTER">Yield/EUR/EUR1D</Index>
    <Index name="USD-SOFR">Yield/USD/USD1D</Index>
    <Index name="USD-LIBOR-3M">Yield/USD/USD3M</Index>
    <Index name="USD-LIBOR-6M">Yield/USD/USD6M</Index>
  </IndexForwardingCurves>

  <SwapIndexCurves id="default">
    <SwapIndex name="EUR-CMS-1Y">
      <Discounting>EUR-ESTER</Discounting>
    </SwapIndex>
    <SwapIndex name="EUR-CMS-30Y">
      <Discounting>EUR-ESTER</Discounting>
    </SwapIndex>
    <SwapIndex name="USD-CMS-1Y">
      <Discounting>USD-SOFR</Discounting>
    </SwapIndex>
    <SwapIndex name="USD-CMS-30Y">
      <Discounting>USD-SOFR</Discounting>
    </SwapIndex>
  </SwapIndexCurves>

  <FxSpots id="default">
    <FxSpot pair="EURUSD">FX/EUR/USD</FxSpot>
  </FxSpots>

  <EquityCurves id="default">
    <EquityCurve name="SP5">Equity/USD/SP5</EquityCurve>
    <EquityCurve name="SP5-USD">Equity/USD/SP5</EquityCurve>
  </EquityCurves>

  <EquityVolatilities id="default">
    <EquityVolatility name="SP5">EquityVolatility/USD/SP5</EquityVolatility>
    <EquityVolatility name="SP5-USD">EquityVolatility/USD/SP5</EquityVolatility>
  </EquityVolatilities>

  <!-- Commodity market mappings for WTI only (FD set trims unused GOLD curves) -->
  <CommodityCurves id="default">
    <CommodityCurve name="COMDTY_WTI_USD">Commodity/USD/WTI_USD</CommodityCurve>
    <CommodityCurve name="WTI_USD">Commodity/USD/WTI_USD</CommodityCurve>
  </CommodityCurves>
  <CommodityVolatilities id="default">
    <CommodityVolatility name="COMDTY_WTI_USD">CommodityVolatility/USD/WTI_USD_VOLS</CommodityVolatility>
    <CommodityVolatility name="WTI_USD">CommodityVolatility/USD/WTI_USD_VOLS</CommodityVolatility>
  </CommodityVolatilities>

  <DefaultCurves id="default">
    <DefaultCurve name="BANK">Default/USD/BANK</DefaultCurve>
    <DefaultCurve name="CPTY_A">Default/USD/CPTY_A_SR_USD</DefaultCurve>
  </DefaultCurves>

  <SwaptionVolatilities id="default">
    <SwaptionVolatility key="EUR">SwaptionVolatility/EUR/EUR_SW_N</SwaptionVolatility>
    <SwaptionVolatility key="USD">SwaptionVolatility/USD/USD_SW_N</SwaptionVolatility>
  </SwaptionVolatilities>

  <CapFloorVolatilities id="default">
  </CapFloorVolatilities>
</TodaysMarket>
