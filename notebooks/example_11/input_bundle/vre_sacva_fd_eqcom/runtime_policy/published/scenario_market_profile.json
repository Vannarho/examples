  "marketDefinitionText": "<Market>\n\n    <BaseCurrency>EUR</BaseCurrency>\n\n    <Currencies>\n      <Currency>EUR</Currency>\n      <Currency>USD</Currency>\n    </Currencies>\n\n    <YieldCurves>\n      <Configuration>\n        <Tenors>1Y,5Y</Tenors>\n        <Interpolation>LogLinear</Interpolation>\n        <Extrapolation>Y</Extrapolation>\n      </Configuration>\n    </YieldCurves>\n\n    <Indices>\n      <Index>EUR-EURIBOR-6M</Index>\n      <Index>USD-LIBOR-3M</Index>\n      <Index>EUR-ESTER</Index>\n      <Index>USD-SOFR</Index>\n    </Indices>\n\n    <DefaultCurves>\n      <SimulateSurvivalProbabilities>true</SimulateSurvivalProbabilities>\n      <SimulateRecoveryRates>false</SimulateRecoveryRates>\n      <Names>\n        <Name>BANK</Name>\n        <Name>CPTY_A</Name>\n      </Names>\n      \n      <Tenors>6M,1Y,5Y</Tenors>\n      <Extrapolation>FlatZero</Extrapolation>\n    </DefaultCurves>\n\n    <FxRates>\n      <Simulate>true</Simulate>\n      <CurrencyPairs>\n        <CurrencyPair>EURUSD</CurrencyPair>\n        <CurrencyPair>USDEUR</CurrencyPair>\n      </CurrencyPairs>\n    </FxRates>\n\n    \n    <SwapIndices>\n      <SwapIndex>\n        <Name>EUR-CMS-1Y</Name>\n        <DiscountingIndex>EUR-ESTER</DiscountingIndex>\n      </SwapIndex>\n      <SwapIndex>\n        <Name>EUR-CMS-30Y</Name>\n        <DiscountingIndex>EUR-ESTER</DiscountingIndex>\n      </SwapIndex>\n      <SwapIndex>\n        <Name>USD-CMS-1Y</Name>\n        <DiscountingIndex>USD-SOFR</DiscountingIndex>\n      </SwapIndex>\n      <SwapIndex>\n        <Name>USD-CMS-30Y</Name>\n        <DiscountingIndex>USD-SOFR</DiscountingIndex>\n      </SwapIndex>\n    </SwapIndices>\n\n    <FxVolatilities>\n      <Simulate>false</Simulate>\n      <ReactionToTimeDecay>ForwardVariance</ReactionToTimeDecay>\n      <CurrencyPairs>\n        <CurrencyPair>EURUSD</CurrencyPair>\n      </CurrencyPairs>\n      <Expiries>1Y,5Y</Expiries>\n    </FxVolatilities>\n\n    <SwaptionVolatilities>\n      <Simulate>false</Simulate>\n      <Currencies>\n        <Currency>EUR</Currency>\n        <Currency>USD</Currency>\n      </Currencies>\n      <ReactionToTimeDecay>ForwardVariance</ReactionToTimeDecay>\n      <Expiries>1Y,5Y</Expiries>\n      <Terms>5Y,10Y</Terms>\n      <SimulateATMOnly>true</SimulateATMOnly>\n    </SwaptionVolatilities>\n\n    <Equities>\n      <SimulateDividendYield>false</SimulateDividendYield>\n      <Names>\n        <Name>SP5</Name>\n      </Names>\n      <DividendTenors>6M,1Y,2Y</DividendTenors>\n    </Equities>\n\n    <EquityVolatilities>\n      <Simulate>true</Simulate>\n      <ReactionToTimeDecay>ForwardVariance</ReactionToTimeDecay>\n      <Names>\n        <Name>SP5</Name>\n      </Names>\n      <Expiries>6M,5Y,10Y</Expiries>\n    </EquityVolatilities>\n\n    <Commodities>\n      <Simulate>true</Simulate>\n      <Names>\n        <Name>COMDTY_WTI_USD</Name>\n      </Names>\n      <Tenors>1Y,5Y,10Y</Tenors>\n    </Commodities>\n    <CommodityVolatilities>\n      <Simulate>true</Simulate>\n      <ReactionToTimeDecay>ForwardForward</ReactionToTimeDecay>\n      <Names>\n        <Name id=\"COMDTY_WTI_USD\">\n          <Expiries>1Y,5Y,10Y</Expiries>\n          <Moneyness>0.0,1.0</Moneyness>\n        </Name>\n      </Names>\n    </CommodityVolatilities>\n\n  </Market>\n\n",
