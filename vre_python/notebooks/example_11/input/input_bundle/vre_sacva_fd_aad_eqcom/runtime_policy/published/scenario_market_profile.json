mulateDividendYield>false</SimulateDividendYield>\n      <Names>\n        <Name>SP5</Name>\n      </Names>\n      <DividendTenors>6M,1Y,2Y</DividendTenors>\n    </Equities>\n    <EquityVolatilities>\n      <Names>\n        <Name>SP5</Name>\n      </Names>\n      <Simulate>true</Simulate>\n      <ReactionToTimeDecay>ForwardVariance</ReactionToTimeDecay>\n      <Expiries>6M,5Y,10Y</Expiries>\n    </EquityVolatilities>\n\n    <Commodities>\n      <Simulate>true</Simulate>\n      <Names>\n        <Name>COMDTY_WTI_USD</Name>\n      </Names>\n      <Tenors>0D,1Y,5Y,10Y</Tenors>\n    </Commodities>\n    <CommodityVolatilities>\n      <Simulate>true</Simulate>\n      <ReactionToTimeDecay>ForwardForward</ReactionToTimeDecay>\n      <Names>\n        <Name id=\"COMDTY_WTI_USD\">\n          <Expiries>1Y,5Y,10Y</Expiries>\n          <Moneyness>0.0,1.0</Moneyness>\n        </Name>\n      </Names>\n    </CommodityVolatilities>\n\n  \n    <Securities><Simulate>false</Simulate></Securities>\n    <Securities>\n      <Simulate>false</Simulate>\n      <Names>\n      <Name>SECURITY_2</Name>\n      <Name>SECURITY_3</Name>\n      <Name>SECURITY_4</Name>\n      <Name>SECURITY_5</Name>\n      </Names>\n    </Securities>\n  \n    <AggregationScenarioDataCurrencies><Currency>EUR</Currency><Currency>USD</Currency></AggregationScenarioDataCurrencies>\n    <AggregationScenarioDataIndices><Index>EUR-EONIA</Index><Index>EUR-ESTER</Index><Index>EUR-EURIBOR-12M</Index><Index>EUR-EURIBOR-1M</Index><Index>EUR-EURIBOR-3M</Index><Index>EUR-EURIBOR-6M</Index><Index>USD-FedFunds</Index><Index>USD-LIBOR-1M</Index><Index>USD-LIBOR-3M</Index><Index>USD-LIBOR-6M</Index><Index>USD-SOFR</Index></AggregationScenarioDataIndices>\n    <AggregationScenarioDataSurvivalWeights><Name>BANK</Name><Name>CPTY_A</Name></AggregationScenarioDataSurvivalWeights>\n    <DefaultCurves><SimulateSurvivalProbabilities>true</SimulateSurvivalProbabilities>\n      <Tenors>6M,1Y,2Y,3Y,5Y,10Y</Tenors></DefaultCurves></Market>\n",
